    //-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    //-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    //-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    std::ofstream OutFile("out.txt");
    if (!OutFile) {
        std::cerr << "Error: Could not create out.txt\n";
        return 1;
    }

    const int CHUNK = 200000;
    const int PASSES = 50;

    for (int pass = 0; pass < PASSES; ++pass) {
        int low = (pass * CHUNK) + 1;
        int high = (pass + 1) * CHUNK; 

        std::ifstream infile("in.txt");
        if (!infile) {
            std::cerr << "Error: Could not open in.txt on pass " << pass << "\n";
            std::cerr << "Make sure in.txt is in the same directory as this program.\n";
            return 1;
        }

        std::vector<int> chunk;
        int val;

        while (infile >> val) {
            if (val >= low && val <= high) {
                chunk.push_back(val);
            }
        }

        infile.close();

        if (!chunk.empty()) {
            Sort(chunk);
            for (int num : chunk) {
                OutFile << num << "\n";
            }
        }

        std::cout << "Finished pass " << pass + 1 << " of " << PASSES << "\n";
    }

    OutFile.close();
    std::cout << "Sorting complete. Check out.txt.\n";
    return 0;
