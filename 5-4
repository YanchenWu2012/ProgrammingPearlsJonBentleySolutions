#include <iostream>
#include <vector>
#include <algorithm>

int BinarySearch(const std::vector<int>& arr, int target) {
    int low = 0;
    int high = arr.size() - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] == target) {
            return mid;
        }
        else if (arr[mid] < target) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }
    return -1;
}

int main() {
    std::vector<int> unsortedArray = {1,4,2,5,7,3,9,13,14,87,32,43};
    int target = 4;

    int result = BinarySearch(unsortedArray, target);
    std::cout << "result:" << unsortedArray[result] << " expected:" << target <<"\n";

    if (unsortedArray[result] != target) {
        std::cout << "fail\n";
    }
    else {
        std::cout << "pass\n";

    }

    return 0;
}
