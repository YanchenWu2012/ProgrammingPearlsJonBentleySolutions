#include <iostream>
#include <vector>
#include <tuple>

using namespace std;

int main() {
    int n = 5; 
    vector<double> diff(n + 1, 0.0);

    vector<tuple<int, int, double>> operations = {
        { 1, 3, 2.5 },
        { 0, 2, 1.0 },
        { 2, 4, 3.0 }
    };

    for (const auto& op : operations) {
        int l = get<0>(op);
        int u = get<1>(op);
        double v = get<2>(op);

        diff[l] += v;
        if (u + 1 <= n) {
            diff[u + 1] -= v;
        }
    }

    vector<double> x(n, 0.0);
    x[0] = diff[0];
    for (int i = 1; i < n; ++i) {
        x[i] = x[i - 1] + diff[i];
    }

    cout << "Result" << endl;
    cout << "Final array x: ";
    for (double val : x) {
        cout << val << " ";
    }
    cout << endl;

    return 0;
}
